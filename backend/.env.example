# ==========================================
# Configuración del Backend - Toros de Tijuana
# ==========================================

# Google Gemini AI (Asistente IA)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Seguridad y Autenticación JWT
JWT_SECRET=tu_secreto_seguro_para_jwt_aqui
JWT_EXPIRATION_HOURS=24

# Entorno y CORS
ENVIRONMENT=production
ALLOWED_ORIGINS=https://tu-dashboard-toros.vercel.app

# Rendimiento y Caché
CACHE_TTL_SECONDS=600

# Base de datos SQLite
SQLITE_DB_PATH=./toros_dashboard.db
